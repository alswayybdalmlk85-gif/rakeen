datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?
  phone     String?
  location  String?
  createdAt DateTime @default(now())
}